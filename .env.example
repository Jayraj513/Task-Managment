# Workline Environment Configuration Template
DJANGO_SECRET_KEY=django-insecure-workline-demo-key-change-this-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database selection:
# Leave DATABASE_URL blank or unset for local SQLite development (db.sqlite3).
# For staging/production, configure a managed PostgreSQL instance:
# DATABASE_URL=postgresql://workline_user:strong_password@ep-db-instance.postgres.database.azure.com:5432/worklinedb?sslmode=require
DATABASE_URL=

# CSRF Trusted Origins (comma-separated domains when deployed behind proxies or HTTPS)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
